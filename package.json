{
  "name": "vacuum",
  "displayName": "vacuum",
  "publisher": "pb33f",
  "description": "vacuum is the world's fastest OpenAPI linter and quality analysis tool.",
  "author": "Quobix",
  "license": "MIT",
  "icon": "square-icon.png",
  "homepage": "https://quobix.com/vacuum/",
  "repository": {
    "type": "git",
    "url": "https://github.com/daveshanley/vacuum.git"
  },
  "version": "0.0.8",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vacuum.lint",
        "title": "vacuum: Start Linting"
      },
      {
        "command": "vacuum.stopLint",
        "title": "vacuum: Stop Linting"
      },
      {
        "command": "vacuum.refresh",
        "title": "vacuum: Refresh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vacuum",
          "title": "vacuum",
          "icon": "resources/vacuum.svg"
        }
      ]
    },
    "views": {
      "vacuum": [
        {
          "id": "vacuumViolations",
          "name": "Violations"
        },
        {
          "id": "vacuumStatistics",
          "name": "Statistics",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:webview": "vite build --config vite.webview.config.ts",
    "watch": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "watch:webview": "vite build --watch --config vite.webview.config.ts",
    "vscode:prepublish": "npm run build",
    "compile": "npm run build",
    "pretest": "npm run build",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.19.5",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@pb33f/cowboy-components": "file:../../../cowboy-components",
    "@quobix/vacuum": "^0.9.1",
    "lit": "^3.1.0",
    "vscode-languageclient": "^7.0.0"
  }
}
