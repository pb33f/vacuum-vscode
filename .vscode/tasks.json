{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "build",
			"group": "build",
			"problemMatcher": [],
			"label": "npm: build",
			"detail": "Build extension and webviews"
		},
		{
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "^✘ \\[ERROR\\] (.*)$",
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[watch\\]",
					"endsPattern": "^⚡ Done"
				}
			},
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "npm: watch",
			"detail": "Watch extension and webviews for changes"
		}
	]
}
